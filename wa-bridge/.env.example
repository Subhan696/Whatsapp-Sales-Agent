# Port the bridge's outbound HTTP server listens on (WaWebClient -> bridge).
BRIDGE_PORT=3000

# Where the bridge POSTs inbound messages (bridge -> FastAPI).
PYTHON_INBOUND_URL=http://localhost:8000/wa-bridge/inbound

# Optional shared secret. If set, must match WA_BRIDGE_TOKEN in the Python .env.
# Protects both directions (inbound POST header + outbound /send auth).
WA_BRIDGE_TOKEN=

# Comma-separated tenant ids this bridge process manages — one independent
# WhatsApp session per id (separate QR scan, separate ./.baileys_auth/<id>/
# folder). Defaults to "1" for single-tenant use.
# Example for three tenants sharing this bridge: WA_WEB_TENANT_IDS=1,2,5
WA_WEB_TENANT_IDS=1

# Baileys' internal pino logger level. Default "silent" — Baileys is chatty
# at info/debug. Set to "warn" or "debug" when troubleshooting a connection.
WA_LOG_LEVEL=silent

# Optional: Postgres connection string for DB-backed auth state (table
# baileys_auth_state, see alembic/versions/0014_baileys_auth_state.py) —
# sessions then survive a redeploy onto a different machine, not just a
# same-box restart. Plain "postgresql://" form for node-postgres, NOT the
# "postgresql+asyncpg://" form used in the Python .env (different driver).
# Leave unset to fall back to local file storage (./.baileys_auth/<tenantId>/).
WA_BRIDGE_DATABASE_URL=
