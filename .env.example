# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace_with_your_own_verify_token
META_APP_SECRET=replace_with_your_meta_app_secret
META_ACCESS_TOKEN=replace_with_your_meta_access_token
META_PHONE_NUMBER_ID=replace_with_your_phone_number_id
META_GRAPH_API_VERSION=v21.0
ADMIN_WHATSAPP_NUMBER=+10000000000

# Commerce
DEFAULT_COMMERCE_MODE=whatsapp_only   # website | whatsapp_only
TAX_RATE=0.17
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# LLM
LLM_PROVIDER=anthropic                # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
VISION_MODEL=

# Compliance / ops
SERVICE_WINDOW_HOURS=24
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
ENABLE_METRICS=true
LOG_LEVEL=INFO

# Public URL for serving uploaded product images/videos to WhatsApp
# Set to your ngrok URL while developing, e.g. https://abc123.ngrok-free.app
# (leave as localhost for local-only dashboard use)
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/wa_agent

# Platform-level secret gating tenant management (create/list/rotate-key).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to lock tenant management entirely (fails closed).
SUPERADMIN_KEY=

# Master key for encrypting sensitive AppSetting values (e.g. meta_access_token)
# at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable encryption (values stored as plaintext, with a
# startup warning) — fine for local dev, not for anything with real tenants.
SECRETS_ENCRYPTION_KEY=
